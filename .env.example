# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.

# --- PostgreSQL ---
POSTGRES_DB=postgres_pitch
POSTGRES_USER=postgres_pitch_admin
POSTGRES_PASSWORD=change_me
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=change_me

# --- Patroni / etcd ---
PATRONI_SCOPE=postgres-pitch-cluster
ETCD_CLUSTER_TOKEN=change_me

# --- PgBouncer ---
PGBOUNCER_AUTH_USER=pgbouncer_auth
PGBOUNCER_AUTH_PASSWORD=change_me

# --- pgBackRest ---
PGBACKREST_REPO_TYPE=s3
PGBACKREST_S3_BUCKET=change_me
PGBACKREST_S3_ENDPOINT=change_me
PGBACKREST_S3_KEY=change_me
PGBACKREST_S3_KEY_SECRET=change_me

# --- Monitoring ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# --- Data sources (see DATA_SOURCES.md) ---
FOOTBALL_DATA_ORG_API_KEY=change_me
API_FOOTBALL_KEY=
THESPORTSDB_API_KEY=

# --- Terraform / cloud (filled in during Iteration 8) ---
CLOUD_PROVIDER_ACCESS_KEY=
CLOUD_PROVIDER_SECRET_KEY=
